---
// Merch page. Products come from src/data/merch.json; checkout happens in the Printify store.
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { Image } from "astro:assets";
import merch from "../data/merch.json";
import { site } from "../data/site";

const images = import.meta.glob<{ default: ImageMetadata }>("../assets/merch/*.{png,jpg,jpeg,webp}", { eager: true });
const imageFor = (file: string): ImageMetadata | undefined => images[`../assets/merch/${file}`]?.default;
// Only keep gallery pictures whose file actually exists in src/assets/merch/.
const galleryOf = (p: (typeof merch.products)[number]) =>
  p.images.map((i) => ({ src: imageFor(i.file), alt: i.alt })).filter((i): i is { src: ImageMetadata; alt: string } => !!i.src);
const money = (n: number) => `US$${n.toFixed(2)}`;
---

<Base
  title="Merch | Tanjore Indian Cuisine, Belleville ON"
  description="Official Tanjore Indian Cuisine merch: Butter Chicken King hoodies and tees, and the Tanjore Classic tee. Family recipes since 2004."
  noindex={!merch.live}
>
  <Header />
  <main id="main">
    <section class="section" style="padding-bottom: var(--space-6);">
      <div class="container" style="text-align:center; max-width: 760px; margin-inline:auto;">
        <span class="eyebrow">Official merch</span>
        <h1 style="font-size: var(--fs-3xl);">Tanjore Merch</h1>
        <p class="muted" style="font-size: var(--fs-md); margin-top: var(--space-4);">
          Wear the story. Butter Chicken King is inspired by the butter chicken our chef has been making for over 20 years.
        </p>
      </div>
    </section>

    <section class="section" style="padding-top: 0;">
      <div class="container">
        <div class="merch-grid">
          {merch.products.filter((p) => p.show).map((p) => {
            const gallery = galleryOf(p);
            return (
              <article class="merch-card" data-merch-card>
                <div class="merch-photo">
                  {gallery.length ? (
                    gallery.map((g, i) => (
                      <Image
                        src={g.src}
                        alt={g.alt}
                        width={720}
                        quality={75}
                        loading={i === 0 ? "eager" : "lazy"}
                        class="merch-slide"
                        data-slide
                        hidden={i !== 0}
                      />
                    ))
                  ) : (
                    <span class="merch-photo-empty">Photo coming soon</span>
                  )}
                </div>
                {gallery.length > 1 && (
                  <div class="merch-thumbs" role="group" aria-label={`${p.name} photos`}>
                    {gallery.map((g, i) => (
                      <button type="button" class="merch-thumb" data-thumb={i} aria-pressed={i === 0 ? "true" : "false"} aria-label={`Show photo ${i + 1}: ${g.alt}`}>
                        <Image src={g.src} alt={g.alt} width={120} height={120} quality={60} loading="lazy" />
                      </button>
                    ))}
                  </div>
                )}
                <div class="merch-body">
                  <h2>{p.name}</h2>
                  <p class="muted small">{p.description}</p>
                  {p.price !== null && <p class="merch-price">From {money(p.price)}</p>}
                  {p.url ? (
                    <a href={p.url} target="_blank" rel="noopener noreferrer" class="btn btn-primary">Shop now</a>
                  ) : (
                    <span class="btn btn-primary" aria-disabled="true">Coming soon</span>
                  )}
                </div>
              </article>
            );
          })}
        </div>

        <section class="merch-policy" aria-labelledby="merch-policy-title">
          <h2 id="merch-policy-title">Shipping &amp; returns</h2>
          <ul>
            <li>Prices are in US dollars, and shipping is calculated at checkout.</li>
            <li>
              Every item is printed to order, so please allow a few business days for production, plus shipping time.
              Delivery times and costs are shown at checkout.
            </li>
            <li>
              If your item arrives damaged, misprinted or defective, contact us within 30 days of delivery with a photo
              and we will replace or refund it.
            </li>
            <li>
              Because items are made to order, we can't accept returns or exchanges for size or change of mind. Please
              check the size chart before ordering.
            </li>
            <li>
              Questions? Call <a href={`tel:${site.phone}`}>{site.phoneDisplay}</a> or email
              <a href={`mailto:${merch.supportEmail}`}>{merch.supportEmail}</a>.
            </li>
          </ul>
        </section>
      </div>
    </section>
  </main>
  <Footer />

  <script>
    import "../scripts/merch-gallery.ts";
  </script>
</Base>
